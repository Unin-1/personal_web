---
import { getCollection, type CollectionEntry } from "astro:content";
import type { Page } from "astro";
import PostPage from "@/components/layout/PostPage.astro";
import Pagination from "@/components/common/Pagination.astro";
import { galleryConfig } from "@/config/galleryConfig";
import { getEnabledFriends } from "@/config/friendsConfig";
import { readBilibiliSnapshot } from "@/utils/bilibili-utils";
import { layoutConfig } from "@/utils/layout-config";
import { getPostUrlBySlug, url } from "@/utils/url-utils";
import { getAlbumCover, scanAlbumPhotos } from "@/utils/gallery-utils";
import { resolveProjectMetadata, getProjectStatusMeta } from "@/utils/projects-utils";

interface Props { page: Page<CollectionEntry<"posts">>; }
const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;
const featured = page.data.find((entry) => entry.data.pinned) || page.data[0];
const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => (b.data.order || 0) - (a.data.order || 0)).slice(0, 3)
  .map((entry) => ({ ...entry, data: resolveProjectMetadata(entry.data) }));
const albums = galleryConfig.albums.slice(0, 2).map((album) => ({ ...album, cover: getAlbumCover(album, scanAlbumPhotos(album.id)) }));
const anime = readBilibiliSnapshot().items.slice(0, 4);
const friends = getEnabledFriends().slice(0, 4);
---

<div class="home-modules">
  {layoutConfig.homeModules.map((module) => (
    <section data-home-module={module.id} hidden={!module.enabled || (!isFirstPage && module.id !== "posts")} class="home-module">
      {module.id === "intro" && (
        <div class="card-base welcome-note">
          <div><span class="eyebrow">A LITTLE CORNER OF THE INTERNET</span><h2>把日子过成喜欢的样子。</h2><p>写点代码，看看风景，追一部喜欢的番。这里收藏着我的热爱，也欢迎你的到来。</p></div>
          <a class="soft-button" href={url("/about/")}>认识 Unin <span aria-hidden="true">↗</span></a>
        </div>
      )}
      {module.id === "featured" && featured && (
        <a href={getPostUrlBySlug(featured.id)} class="card-base featured-note">
          <span class="eyebrow">PICKED FOR YOU · 编辑精选</span><h2>{featured.data.title}</h2><p>{featured.data.description}</p><span class="read-link">读一读 <span aria-hidden="true">→</span></span>
        </a>
      )}
      {module.id === "posts" && (
        <>
          <div class="section-heading"><div><span class="eyebrow">LATEST NOTES</span><h2>最近写了什么</h2></div><a href={url("/archive/")}>全部文章 <span aria-hidden="true">↗</span></a></div>
          <PostPage page={page} />
          {page.total > page.size && <Pagination class="mx-auto" page={page} />}
        </>
      )}
      {module.id === "projects" && (
        <div class="card-base home-panel">
          <div class="section-heading"><div><span class="eyebrow">MADE WITH CURIOSITY</span><h2>正在折腾</h2></div><a href={url("/projects/")}>全部项目 ↗</a></div>
          <div class="mini-grid">{projects.map((entry) => (
            <a class="mini-card" href={url(`/projects/${entry.id.replace(/\.(md|mdx)$/, "")}/`)}>
              <span class="mini-icon" aria-hidden="true">⌘</span><h3>{entry.data.title}</h3>
              <p>{entry.data.description || "每一份灵感，都从一个小小的开始出发。"}</p>
              <div class="mini-meta">{entry.data.status && <span>{getProjectStatusMeta(entry.data.status).label}</span>}{entry.data.language && <span>{entry.data.language}</span>}{entry.data.stars !== undefined && <span>☆ {entry.data.stars}</span>}</div>
            </a>
          ))}</div>
          {!projects.length && <p class="empty-note">新的灵感还在酝酿中。</p>}
        </div>
      )}
      {module.id === "gallery" && (
        <div class="card-base home-panel">
          <div class="section-heading"><div><span class="eyebrow">LIFE IN FRAMES</span><h2>光影收藏夹</h2></div><a href={url("/gallery/")}>翻开相册 ↗</a></div>
          <div class="album-preview-grid">{albums.map((album) => (
            <a class="album-preview" href={url(`/gallery/${album.id}/`)}>
              {album.cover && <img src={album.cover} alt={album.name} loading="lazy" width="640" height="360" />}<div><h3>{album.name}</h3><p>{album.description}</p></div>
            </a>
          ))}</div>
        </div>
      )}
      {module.id === "anime" && (
        <div class="card-base home-panel">
          <div class="section-heading"><div><span class="eyebrow">ONE MORE EPISODE</span><h2>次元放映室</h2></div><a href={url("/bilibili/")}>追番记录 ↗</a></div>
          {anime.length ? <div class="anime-preview-grid">{anime.map((item) => <a href={item.link} target="_blank" rel="noopener noreferrer">{item.poster && <img src={item.poster} alt="" width="120" height="168" loading="lazy" referrerpolicy="no-referrer" />}<h3>{item.title}</h3><p>番剧更新：{item.epStatus || "暂无信息"}</p></a>)}</div> : <p class="empty-note">把喜欢的故事，留在这里慢慢看。<a href={url("/bilibili/")}>查看追番记录 →</a></p>}
        </div>
      )}
      {module.id === "links" && (
        <div class="card-base home-panel">
          <div class="section-heading"><div><span class="eyebrow">NEIGHBORS & FRIENDS</span><h2>去别处逛逛</h2></div><a href={url("/friends/")}>友链小径 ↗</a></div>
          <div class="friend-preview-list">{friends.map((friend) => <a href={friend.siteurl} target="_blank" rel="noopener noreferrer"><span aria-hidden="true">✧</span><div><h3>{friend.title}</h3><p>{friend.desc}</p></div><span aria-hidden="true">↗</span></a>)}</div>
        </div>
      )}
    </section>
  ))}
</div>

<style>
  .home-modules { --text-90: #253d36; --text-60: #61736c; display: flex; flex-direction: column; gap: 1.25rem; }
  :global(.dark) .home-modules { --text-90: #e4efea; --text-60: #adbbb5; }
  .home-module[hidden] { display: none !important; }
  .home-panel, .welcome-note, .featured-note { padding: clamp(1.25rem, 3vw, 2rem); border-radius: var(--radius-large); }
  .welcome-note { display: flex; gap: 1.5rem; align-items: center; justify-content: space-between; }
  .eyebrow { color: var(--primary); font-size: .62rem; font-weight: 750; letter-spacing: .18em; }
  h2 { font-size: clamp(1.2rem, 2.3vw, 1.65rem); font-weight: 750; line-height: 1.55; margin: .4rem 0; color: var(--text-90); }
  p { color: var(--text-60); font-size: .85rem; line-height: 1.85; }
  .soft-button { flex-shrink: 0; color: var(--primary); padding: .65rem 1rem; border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent); border-radius: 999px; font-size: .8rem; background: color-mix(in srgb, var(--primary) 6%, transparent); }
  .featured-note { display: block; background-image: linear-gradient(110deg, color-mix(in srgb, var(--primary) 10%, transparent), transparent 70%); position: relative; overflow: hidden; }
  .featured-note h2 { font-size: 1.25rem; }
  .featured-note .read-link { display: inline-block; margin-top: 1rem; color: var(--primary); font-size: .8rem; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .section-heading h2 { font-size: 1.2rem; margin-bottom: 0; }
  .section-heading > a { font-size: .75rem; flex-shrink: 0; color: var(--primary); }
  .mini-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: .75rem; }
  .mini-card { padding: 1.2rem; border-radius: 1rem; border: 1px solid color-mix(in srgb, var(--primary) 14%, transparent); transition: transform .2s, background .2s; }
  .mini-card:hover { transform: translateY(-3px); background: color-mix(in srgb, var(--primary) 6%, transparent); }
  .mini-card h3, .album-preview h3, .friend-preview-list h3, .anime-preview-grid h3 { font-size: .95rem; font-weight: 650; color: var(--text-90); }
  .mini-icon { display: inline-flex; background: color-mix(in srgb, var(--primary) 10%, transparent); padding: .25rem .65rem; border-radius: .65rem; margin-bottom: .6rem; color: var(--primary); }
  .mini-meta { display: flex; gap: .75rem; color: var(--primary); font-size: .7rem; margin-top: 1rem; }
  .album-preview-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 1rem; }
  .album-preview { border-radius: 1rem; overflow: hidden; background: color-mix(in srgb, var(--primary) 5%, transparent); }
  .album-preview img { width: 100%; aspect-ratio: 16/7; object-fit: cover; }
  .album-preview > div { padding: 1rem; }
  .empty-note { padding: 1rem 0; }
  .empty-note a { color: var(--primary); display: block; padding-top: .5rem; }
  .friend-preview-list a { display: flex; align-items: center; gap: 1rem; padding: .6rem 0; }
  .friend-preview-list a > span { color: var(--primary); }
  .friend-preview-list a > span:last-child { margin-left: auto; }
  .anime-preview-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; }
  .anime-preview-grid img { border-radius: .6rem; width: 100%; aspect-ratio: 5/7; object-fit: cover; }
  .anime-preview-grid h3 { font-size: .8rem; margin-top: .5rem; }
  .anime-preview-grid p { font-size: .7rem; }
  @media(max-width: 640px) { .welcome-note { align-items: flex-start; flex-direction: column; gap: 1rem; } .anime-preview-grid { grid-template-columns: repeat(2, 1fr); } }
  @media(prefers-reduced-motion: reduce) { .mini-card { transition: none; } }
</style>
