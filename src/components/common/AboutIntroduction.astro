---
import TypingTerminal from "./TypingTerminal.astro";

// Adapt rendered Markdown without rewriting the author's personal source file.
const content = await Astro.slots.render("default");
let insertion = -1;
let end = -1;
let code = 'print("Welcome!")';

for (const match of content.matchAll(/<p(?:\s[^>]*)?>[\s\S]*?<\/p>/g)) {
  const text = match[0]
    .replace(/<[^>]*>/g, "")
    .replace(/&quot;|&#34;|&#x22;/gi, '"')
    .replace(/&apos;|&#39;|&#x27;/gi, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&amp;/g, "&")
    .trim();
  if (/^print\((["']).*\1\)$/.test(text)) {
    insertion = match.index;
    end = insertion + match[0].length;
    code = text;
    break;
  }
}

if (insertion === -1) {
  const heading = /<\/h1\s*>/i.exec(content);
  insertion = heading ? heading.index + heading[0].length : 0;
  end = insertion;
}
---

<Fragment set:html={content.slice(0, insertion)} />
<TypingTerminal code={code} />
<Fragment set:html={content.slice(end)} />
