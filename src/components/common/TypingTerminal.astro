---
interface Props {
  code?: string;
}

const { code = 'print("Welcome!")' } = Astro.props;
---

<typing-terminal class="typing-terminal not-prose" data-code={code} data-state="complete">
  <div class="terminal-bar" aria-hidden="true">
    <span class="terminal-lights"><i></i><i></i><i></i></span>
    <span>python</span>
    <span class="terminal-bar-spacer"></span>
  </div>
  <pre aria-label="Python 终端"><span class="terminal-prompt" aria-hidden="true">&gt;&gt;&gt; </span><code><span class="terminal-sr-only">{code}</span><span aria-hidden="true"><span data-typing-text>{code}</span><span class="terminal-cursor"></span></span></code></pre>
</typing-terminal>

<script>
  class TypingTerminal extends HTMLElement {
    private timer: ReturnType<typeof setTimeout> | undefined;
    private listeners: AbortController | undefined;
    private output: HTMLElement | null = null;
    private characters: string[] = [];
    private position = 0;

    connectedCallback() {
      this.clear();
      this.output = this.querySelector("[data-typing-text]");
      if (!this.output) return;

      this.characters = Array.from(this.dataset.code || "");
      this.position = 0;
      this.listeners = new AbortController();
      const { signal } = this.listeners;
      const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
      motion.addEventListener("change", () => {
        if (motion.matches) this.finish();
      }, { signal });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) this.finish();
      }, { signal });
      window.addEventListener("pagehide", () => this.finish(), { signal });

      if (motion.matches || document.hidden) {
        this.finish();
        return;
      }

      this.output.textContent = "";
      this.dataset.state = "typing";
      this.timer = setTimeout(() => this.typeNext(), 250);
    }

    disconnectedCallback() {
      this.clear();
    }

    private typeNext() {
      if (!this.isConnected || !this.output) return;
      this.position += 1;
      this.output.textContent = this.characters.slice(0, this.position).join("");
      if (this.position >= this.characters.length) {
        this.finish();
        return;
      }
      this.timer = setTimeout(() => this.typeNext(), 85);
    }

    private finish() {
      clearTimeout(this.timer);
      this.timer = undefined;
      if (this.output) this.output.textContent = this.characters.join("");
      this.dataset.state = "complete";
    }

    private clear() {
      clearTimeout(this.timer);
      this.timer = undefined;
      this.listeners?.abort();
      this.listeners = undefined;
    }
  }

  if (!customElements.get("typing-terminal")) {
    customElements.define("typing-terminal", TypingTerminal);
  }
</script>

<style>
  .typing-terminal {
    display: block;
    margin: 1.25rem 0 1.75rem;
    overflow: hidden;
    color: var(--tw-prose-body, var(--deep-text));
    background: color-mix(in oklab, var(--card-bg) 65%, var(--btn-regular-bg));
    border: 1px solid var(--line-divider);
    border-radius: 0.85rem;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    color: var(--content-meta);
    background: color-mix(in oklab, var(--btn-regular-bg) 70%, var(--card-bg));
    border-bottom: 1px solid var(--line-divider);
    font: 0.75rem / 1.25 ui-monospace, monospace;
  }

  .terminal-lights,
  .terminal-bar-spacer {
    display: flex;
    gap: 0.35rem;
    width: 2.8rem;
  }

  .terminal-lights i {
    width: 0.55rem;
    height: 0.55rem;
    background: color-mix(in oklab, #d99595 75%, var(--card-bg));
    border-radius: 50%;
  }

  .terminal-lights i:nth-child(2) { background: color-mix(in oklab, #d1bd83 75%, var(--card-bg)); }
  .terminal-lights i:nth-child(3) { background: color-mix(in oklab, #92b8a5 75%, var(--card-bg)); }

  pre {
    margin: 0;
    padding: 1.25rem;
    overflow-x: auto;
    color: inherit;
    background: transparent;
    font: 1rem / 1.7 var(--font-code, ui-monospace, monospace);
    white-space: pre;
  }

  .typing-terminal code {
    padding: 0;
    overflow: visible;
    color: inherit;
    background: transparent;
    border-radius: 0;
    font: inherit;
  }
  .terminal-prompt { color: var(--btn-content); }
  [data-typing-text] { color: inherit; }

  .terminal-cursor {
    display: none;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.15em;
    vertical-align: -0.17em;
    background: var(--btn-content);
    opacity: 0.65;
  }

  [data-state="typing"] .terminal-cursor {
    display: inline-block;
    animation: terminal-blink 0.9s step-end infinite;
  }

  .terminal-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @keyframes terminal-blink { 50% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .terminal-cursor { animation: none !important; }
  }
</style>
